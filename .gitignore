# ── Moodle, Matrix y Maubot (Secretos, runtime y volúmenes) ──
# Variables de entorno locales
moodle-matrix-dev/.env

# Maubot (datos locales de tiempo de ejecución y secretos)
moodle-matrix-dev/maubot/llm-wiki-assistant-plugin/base-config.yaml
moodle-matrix-dev/maubot/maubot-data/config.yaml
moodle-matrix-dev/maubot/maubot-data/maubot.db*
moodle-matrix-dev/maubot/maubot-data/dbs/
moodle-matrix-dev/maubot/maubot-data/plugins/
moodle-matrix-dev/maubot/maubot-data/trash/
moodle-matrix-dev/maubot/maubot-data/maubot-cli.json

# Synapse (Base de datos SQLite, firmas y ficheros multimedia subidos)
moodle-matrix-dev/synapse-data/*.db
moodle-matrix-dev/synapse-data/*.db-shm
moodle-matrix-dev/synapse-data/*.db-wal
moodle-matrix-dev/synapse-data/*.signing.key
moodle-matrix-dev/synapse-data/*.log.config
moodle-matrix-dev/synapse-data/*.pid
moodle-matrix-dev/synapse-data/media_store/

# Ollama (Almacén de modelos locales de IA)
moodle-matrix-dev/ollama-data/

# Ignorar ficheros de bases de datos de prueba en todo el árbol
**/*.db
**/*.db-shm
**/*.db-wal
homeserver.db
